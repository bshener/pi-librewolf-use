{
  "manifest_version": 2,
  "name": "LibreWolf Pi Bridge",
  "version": "0.1.1",
  "description": "Lets Pi control tabs in LibreWolf via a local bridge at 127.0.0.1. No flags, no Marionette — just install and keep LibreWolf open.",
  "permissions": [
    "tabs",
    "activeTab",
    "webNavigation",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "librewolf-pi-bridge@example.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": []
      }
    }
  }
}
